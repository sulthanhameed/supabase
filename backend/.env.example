# ---- Server ----
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-frontend.vercel.app,http://localhost:3000

# ---- Database (PostgreSQL: Render Postgres / Neon / Supabase) ----
DATABASE_URL=postgres://user:password@host:5432/khang

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@khang.com
ADMIN_PASSWORD=admin123

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# ---- Email (Nodemailer / Gmail SMTP) — confirmations go to customer + OWNER_EMAIL ----
OWNER_EMAIL=sultham456@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your@gmail.com

# ---- SMS (Fast2SMS) ----
FAST2SMS_API_KEY=
