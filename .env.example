# ═════════════════════════════════════════════════════════════════════
#  KHANG — environment variables
#  One Next.js app (frontend + built-in API) + Supabase Postgres backend.
#  Copy to .env for local development. On Vercel: Settings → Environment
#  Variables (Production + Preview).
# ═════════════════════════════════════════════════════════════════════

# ── REQUIRED · Supabase Postgres ──────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI
# Use the SESSION POOLER URI (host …pooler.supabase.com, port 5432) —
# it works over IPv4 from Vercel. Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Secret used to sign login tokens — any long random string
JWT_SECRET=replace-with-a-long-random-string

# ── OPTIONAL · admin account created on first boot ────────────────────
ADMIN_EMAIL=admin@khang.com
ADMIN_PASSWORD=admin123

# ── OPTIONAL · order confirmation e-mails (Gmail SMTP + App Password) ─
OWNER_EMAIL=sultham456@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── OPTIONAL · Razorpay online payments ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── OPTIONAL · order SMS via Fast2SMS ─────────────────────────────────
FAST2SMS_API_KEY=

# ── LEAVE EMPTY for the normal all-in-one deployment ──────────────────
# Set a URL only if you host the API on a separate server.
NEXT_PUBLIC_API_URL=
