# =============== FRONTEND (Next.js / React) ===============
# URL of the Express backend hosted on Render. When set, the frontend talks to
# the backend ONLY through REST and never connects to the database directly.
NEXT_PUBLIC_API_URL=https://khang-backend.onrender.com

